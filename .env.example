# ==============================================================================
# ProjectFlow Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Used by Docker Compose and Django)
# ------------------------------------------------------------------------------
POSTGRES_DB=projectflow
POSTGRES_USER=projectflow
POSTGRES_PASSWORD=projectflow
POSTGRES_PORT=5432

# Database Connection URL
# For Docker Compose:
DATABASE_URL=postgresql://projectflow:projectflow@db:5432/projectflow
# For Local Development (host PostgreSQL):
# DATABASE_URL=postgresql://projectflow:projectflow@localhost:5432/projectflow
# For Local Development (SQLite fallback):
# DATABASE_URL=sqlite:///db.sqlite3

# ------------------------------------------------------------------------------
# Django Security & Core Settings
# ------------------------------------------------------------------------------
# Set to False in production
DEBUG=False

# In production, generate a strong random secret key (e.g. openssl rand -hex 32)
SECRET_KEY=django-insecure-projectflow-demo-secret-key-change-in-production

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# Demo Mode & Safety
# ------------------------------------------------------------------------------
# When DEMO_MODE=True, the authenticated POST /api/demo/reset endpoint is enabled.
# Set to False in production environments to prevent demo resets.
DEMO_MODE=True

# ------------------------------------------------------------------------------
# Task Runner & Asynchronous Execution
# ------------------------------------------------------------------------------
# Background tasks (e.g. emails) run in a bounded ThreadPoolExecutor.
# Set TASK_RUNNER_SYNC=True to force synchronous execution during automated testing.
TASK_RUNNER_SYNC=False

# ------------------------------------------------------------------------------
# Email Backend Configuration
# ------------------------------------------------------------------------------
# Defaults to in-memory email backend for dev/demo.
# For production SMTP, set:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend

# ------------------------------------------------------------------------------
# Port Mappings for Docker Compose
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# Frontend Environment Variables
# ------------------------------------------------------------------------------
# In container setup, Nginx reverse-proxies /api/ requests to the backend.
# For standalone Vite dev server running outside Docker, point to backend:
VITE_API_URL=http://localhost:8000
