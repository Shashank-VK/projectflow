# ProjectFlow Environment Configuration (.env.example)
# Copy to .env and adjust as necessary.

# Django Security
DEBUG=True
SECRET_KEY=django-insecure-projectflow-demo-secret-key-change-in-production
ALLOWED_HOSTS=*

# Demo Mode & Safety
# When DEMO_MODE=True, the authenticated POST /api/demo/reset endpoint is enabled.
DEMO_MODE=True

# Database Configuration
# Default connects to local PostgreSQL. Falls back to SQLite if sqlite:///path is provided.
DATABASE_URL=postgresql://projectflow:projectflow@localhost:5432/projectflow

# Task Runner Configuration
# In demo/local mode, background threads (ThreadPoolExecutor) run tasks asynchronously.
# Set TASK_RUNNER_SYNC=True to force synchronous execution for automated testing.
TASK_RUNNER_SYNC=False

# Email Backend (defaults to locmem in dev/demo)
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend

# Frontend Proxy Target (for Vite dev server)
VITE_API_URL=http://localhost:8000
